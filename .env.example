# Salin ke .env.local untuk development, atau isi di Vercel > Settings > Environment Variables.
# JANGAN commit file .env.local — isinya rahasia.
NEXT_PUBLIC_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Buat baru, minimal 32 karakter acak. JANGAN pakai ulang secret TemuUndang / habit-tracking / portfolio-v3.
# Contoh buat di terminal: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Connection string Postgres dari Neon — buat PROJECT/DATABASE BARU khusus belajar-cpns,
# jangan pakai database TemuUndang atau portfolio-v3 (tabel user/account/session bakal kecampur).
# Contoh: postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/belajar-cpns?sslmode=require
DATABASE_URL=

# Opsional, bawaan starter kit (tidak dipakai fitur belajar v1).
RESEND_API_KEY=
UPLOADTHING_TOKEN=
